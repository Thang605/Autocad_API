<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PaletteControlSource Condition="'$(PaletteControlSource)' == ''">../../MyFirstProject/Menu form/ToolPaletteControl.cs</PaletteControlSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PaletteControlSource)" Link="ToolPaletteControl.cs" />
    <Compile Include="../../MyFirstProject/Menu form/ToolPaletteDataReader.cs" Link="ToolPaletteDataReader.cs" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>
</Project>
